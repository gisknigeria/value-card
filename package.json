{
  "name": "bodija-value-card",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api dev:security",
    "dev:web": "npm run dev --workspace @bodija/web",
    "dev:api": "npm run start:dev --workspace @bodija/api",
    "dev:security": "npm run dev --workspace @bodija/security",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "setup": "npm run db:generate && npm run db:deploy && npm run db:seed",
    "db:generate": "npm run prisma:generate --workspace @bodija/api",
    "db:migrate": "npm run prisma:migrate --workspace @bodija/api",
    "db:deploy": "npm run prisma:deploy --workspace @bodija/api",
    "db:seed": "npm run prisma:seed --workspace @bodija/api"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "ajv": "^8.18.0",
    "bl": "^7.0.8",
    "c12": "^3.1.0",
    "defu": "^6.1.4",
    "effect": "^3.22.0",
    "jiti": "^2.4.2",
    "npm-run-all": "^4.1.5",
    "pathe": "^2.0.3"
  }
}
